#!/bin/bash
# Wire this clone to the versioned hooks in .githooks/.
#
# Why this exists: the hook script is versioned, but core.hooksPath is local git
# config -- it does NOT travel with a clone. Without this one command the hook
# sits in the tree and never runs. Run it once per clone.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

git config core.hooksPath .githooks
chmod +x .githooks/pre-push .githooks/install

# A leftover .git/hooks/pre-push is now dead code: with core.hooksPath set, git
# ignores .git/hooks entirely. Two copies of one gate drift apart, and the stale
# one reads like protection it no longer provides. Say so out loud.
if [ -e .git/hooks/pre-push ]; then
  echo "figyelem: .git/hooks/pre-push meg letezik, de mar NEM fut (core.hooksPath)."
  echo "         Ha biztos vagy benne hogy a .githooks/pre-push a jo, torold:"
  echo "           rm .git/hooks/pre-push"
fi

echo "core.hooksPath -> $(git config --get core.hooksPath)"
echo "kesz: a pre-push kapu ebben a klonban aktiv."
